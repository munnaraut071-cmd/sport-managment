# Production API Configuration
VITE_API_URL=https://api.sportkits.com/api
VITE_SOCKET_URL=https://api.sportkits.com

# App Configuration
VITE_APP_NAME=Sports Kits Management System
VITE_APP_VERSION=1.0.0
VITE_ENABLE_AI=true
VITE_ENABLE_REALTIME=true

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHATBOT=true

# Environment
VITE_NODE_ENV=production
